APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Optional eDonate rate-limit overrides. Defaults are in config/edonate.php.
# EDONATE_RATE_DONOR_API_PER_MINUTE=60
# EDONATE_RATE_PUBLIC_API_PER_MINUTE=30
# EDONATE_RATE_DONOR_LOGIN_PER_MINUTE=5
# EDONATE_RATE_ADMIN_LOGIN_PER_MINUTE=5
# EDONATE_RATE_LOGIN_IP_PER_TEN_MINUTES=20
# EDONATE_RATE_OTP_SEND_PER_TEN_MINUTES=3
# EDONATE_RATE_OTP_SEND_IP_PER_HOUR=10
# EDONATE_RATE_OTP_VERIFY_PER_TEN_MINUTES=5
# EDONATE_RATE_PASSWORD_RESET_PER_TEN_MINUTES=3
# EDONATE_RATE_PASSWORD_RESET_IP_PER_HOUR=10
# EDONATE_RATE_REGISTRATION_PER_HOUR=5
# EDONATE_RATE_ELIGIBILITY_SUBMIT_PER_TEN_MINUTES=10
# EDONATE_RATE_VERIFICATION_UPLOAD_PER_TEN_MINUTES=5
# EDONATE_RATE_APPOINTMENT_WRITE_PER_MINUTE=10
# EDONATE_RATE_BLOOD_REQUEST_RESPONSE_PER_MINUTE=10
# EDONATE_RATE_NOTIFICATION_SEND_PER_MINUTE=10
# EDONATE_RATE_MAP_API_PER_MINUTE=30
# EDONATE_RATE_REPORTS_API_PER_MINUTE=20
# EDONATE_RATE_REPORT_EXPORT_PER_TEN_MINUTES=5
# EDONATE_RATE_ADMIN_API_PER_MINUTE=120
# EDONATE_RATE_ADMIN_WRITE_PER_MINUTE=30
# EDONATE_RATE_INVENTORY_UPDATE_PER_MINUTE=20
# EDONATE_RATE_DOCUMENT_ACCESS_PER_MINUTE=30
# EDONATE_RATE_ADMIN_2FA_PER_TEN_MINUTES=5

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=
FIREBASE_SECURITY_EVENTS_PATH=admin_security_events

GEOCODING_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT="eDonate-CapstoneProject/1.0 (your-email@example.com)"
GEOCODING_TIMEOUT=10

VITE_APP_NAME="${APP_NAME}"

# Operational display threshold; this is not a medical emergency threshold.
BLOOD_INVENTORY_LOW_STOCK_THRESHOLD=5
